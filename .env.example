# Backend API Base URL
# Local Dev: http://localhost:5000
# Production (Vercel): Set VITE_API_URL in Vercel project environment variables
VITE_API_URL=http://localhost:5000

# Google Apps Script Web App URL (Google Sheets + Drive Contact Backend)
# Production (Vercel): Set VITE_GOOGLE_SHEET_WEB_APP_URL in Vercel project environment variables
VITE_GOOGLE_SHEET_WEB_APP_URL=
